#define ZMK_BEHAVIORS_OMIT_KT

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Layers. WIN sits right above BASE so LO/HI/CFG fall through it; WLO/WHI are
 * conditional layers (active when WIN and LO/HI are both on) holding the
 * Windows replacements for macOS shortcuts. Keep WIN in sync with
 * CONFIG_LILLY_STATUS_SCREEN_WIN_LAYER (lily58.conf) for the screen icon.
 */
#define BASE 0
#define WIN  1
#define LO   2
#define HI   3
#define CFG  4
#define WLO  5
#define WHI  6

/ {
    behaviors {
        bracket_btn: bracket_btn {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        space_ret_btn: space_ret_btn {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&spc_fn>, <&kp RET>;
        };

        grv_tild_btn: grv_tild_btn {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp TILDE>;
        };

        comment_line: comment_line {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp LG(SLASH)>;
        };

        // Space; Ctrl+Space sends native Apple Fn/Globe instead (switch input source).
        // Ctrl is masked so macOS sees a clean Fn press.
        spc_fn: spc_fn {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp APPLE_FN>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        // --- Windows mode variants ---
        spc_win: spc_win {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&kp LG(SPACE)>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        space_ret_win: space_ret_win {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&spc_win>, <&kp RET>;
        };

        comment_line_win: comment_line_win {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp LC(SLASH)>;
        };

        // Windows snap to a quarter: Win+Left/Right, then Win+Up/Down
        win_tl: win_tl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp LEFT &kp UP>, <&macro_release &kp LGUI>;
        };
        win_tr: win_tr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp RIGHT &kp UP>, <&macro_release &kp LGUI>;
        };
        win_bl: win_bl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp LEFT &kp DOWN>, <&macro_release &kp LGUI>;
        };
        win_br: win_br {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <30>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp RIGHT &kp DOWN>, <&macro_release &kp LGUI>;
        };

        // Like &to, but non-locking: it leaves the WIN layer (toggled with the
        // locking &tog) alone, so Windows mode survives layer jumps.
        go: go_layer {
            compatible = "zmk,behavior-to-layer";
            #binding-cells = <1>;
        };

        // Encoder rotation that does nothing (blocks fall-through to lower layers)
        enc_none: enc_none {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Both space keys together: soft-off (both halves). Any key press wakes up.
        soft_off_combo {
            bindings = <&soft_off>;
            key-positions = <53 54>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        win_lo {
            if-layers = <WIN LO>;
            then-layer = <WLO>;
        };
        win_hi {
            if-layers = <WIN HI>;
            then-layer = <WHI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4  &kp N5                                    &kp N6    &kp N7  &kp N8     &kp N9   &kp N0         &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R   &kp T                                     &kp Y     &kp U   &kp I      &kp O    &kp P          &kp EQUAL
&mt LSHFT APPLE_FN  &kp A   &kp S   &kp D     &kp F   &kp G                                     &kp H     &kp J   &kp K      &kp L    &kp SEMI       &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V   &kp B     &bracket_btn    &kp C_MUTE      &kp N     &kp M   &kp COMMA  &kp DOT  &comment_line  &kp RSHFT
                           &kp LALT  &mo LO  &kp LGUI  &spc_fn          &space_ret_btn  &kp BSPC  &mo HI  &kp RET
            >;
            // sensor-bindings: <left encoder>  <right encoder>  (CW, CCW)
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN  &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Windows mode overlay on BASE: Cmd<->Ctrl swapped, language switch = Win+Space
        win_layer {
            display-name = "Base";
            bindings = <
&trans     &trans  &trans  &trans    &trans  &trans                                    &trans    &trans  &trans     &trans   &trans         &trans
&trans     &trans  &trans  &trans    &trans  &trans                                    &trans    &trans  &trans     &trans   &trans         &trans
&mt LSHFT LG(SPACE)  &trans  &trans  &trans    &trans  &trans                              &trans    &trans  &trans     &trans   &trans         &trans
&kp LGUI   &trans  &trans  &trans    &trans  &trans    &trans          &trans          &trans    &trans  &trans     &trans   &comment_line_win  &trans
                           &trans    &trans  &kp LCTRL &spc_win         &space_ret_win  &trans    &trans  &trans
            >;
        };

        lower_layer {
            display-name = "LO";
            bindings = <
&grv_tild_btn  &kp LC(LA(D))               &kp LA(LC(E))     &kp LA(LC(F))           &kp LA(LC(T))      &kp LA(LC(G))                            &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LC(K_MUTE)
&trans     &kp LA(LC(C))               &kp LA(LC(U))     &kp LA(LC(UP_ARROW))    &kp LA(LC(I))      &kp LA(LC(MINUS))                        &kp PIPE        &mkp MB1          &mmv MOVE_UP    &mkp MB2           &none            &go CFG
&trans     &kp LA(LC(LG(RIGHT)))       &kp LA(LC(LEFT))  &kp LA(LC(ENTER))       &kp LA(LC(RIGHT))  &kp LA(LC(EQUAL))                        &kp CARET       &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &none            &none
&trans     &kp LA(LC(LG(LEFT_ARROW)))  &kp LA(LC(J))     &kp LA(LC(DOWN_ARROW))  &kp LA(LC(K))      &kp LA(LC(BACKSPACE))  &trans    &kp LG(N0)  &none           &none             &none           &none              &none            &trans
                                                         &trans                  &go BASE           &trans                 &trans    &trans  &kp DELETE      &go HI            &trans
            >;
            // sensor-bindings: <left encoder>  <right encoder>  (CW, CCW)
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)  &inc_dec_kp LG(EQUAL) LG(MINUS)>;
        };

        // macOS: Cmd+Left/Right = line start/end, Cmd+Up/Down = document start/end
        raise_layer {
            display-name = "HI";
            bindings = <
&kp TILDE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                      &kp F6     &kp F7    &kp F8        &kp F9         &kp F10  &kp LG(LS(NUMBER_4))
&trans     &none   &none   &none   &none   &none                       &kp PG_UP  &kp LG(LEFT)  &kp UP_ARROW  &kp LG(RIGHT)  &kp LG(UP)    &kp LG(LS(N5))
&trans     &none   &none   &none   &none   &none                       &kp PG_DN  &kp LEFT      &kp DOWN      &kp RIGHT      &kp LG(DOWN)  &kp LG(LS(NUMBER_3))
&trans     &none   &none   &none   &none   &none   &trans     &none    &none      &none     &kp SLASH     &kp BACKSLASH  &none    &none
                           &trans  &go LO  &trans  &kp F11    &kp F12  &trans     &go BASE  &trans
            >;
            // sensor-bindings: <left encoder>  <right encoder>  (CW, CCW)
            sensor-bindings = <&enc_none  &enc_none>;
        };

        cfg_layer {
            display-name = "Cfg";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4                  &none  &none  &none  &none  &none  &bt BT_CLR_ALL
&none       &none             &tog WIN           &none              &none         &none                         &none  &none  &none  &none  &none  &none
&none       &none             &none              &none              &none         &none                         &none  &none  &none  &none  &none  &none
&none       &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &none         &none         &none    &none  &none  &none  &none  &none  &none  &none
                                                 &none              &go BASE      &none         &none    &none  &none  &go BASE  &none
            >;
            // sensor-bindings: <left encoder>  <right encoder>  (CW, CCW)
            sensor-bindings = <&enc_none  &enc_none>;
        };

        // Windows replacements on LO (active when WIN + LO): native snapping where it exists.
        // Thirds / center / top-bottom halves / smaller-larger keep Ctrl+Alt+... (bind them in
        // PowerToys FancyZones or similar).
        win_lower_layer {
            display-name = "LO";
            bindings = <
&trans  &trans                 &trans          &trans          &trans           &trans                                 &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                 &win_tl         &trans          &win_tr          &trans                                 &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(LS(RIGHT))      &kp LG(LEFT)    &kp LG(UP)      &kp LG(RIGHT)    &trans                                 &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(LS(LEFT))       &win_bl         &trans          &win_br          &kp LG(DOWN)  &trans    &kp LC(N0)     &trans  &trans  &trans  &trans  &trans  &trans
                                               &trans          &trans           &trans        &trans    &trans  &trans  &trans  &trans
            >;
            // sensor-bindings: <left encoder>  <right encoder>  (CW, CCW)
            sensor-bindings = <&inc_dec_kp LC(EQUAL) LC(MINUS)  &inc_dec_kp LC(EQUAL) LC(MINUS)>;
        };

        // Windows replacements on HI (active when WIN + HI)
        win_raise_layer {
            display-name = "HI";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans        &trans  &trans        &trans         &kp LG(LS(S))
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &kp HOME      &trans  &kp END       &kp LC(HOME)   &kp LG(LS(S))
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans        &trans  &trans        &kp LC(END)    &kp PSCRN
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans        &trans  &trans        &trans         &trans
                        &trans  &trans  &trans  &trans    &trans    &trans  &trans        &trans
            >;
        };
    };
};
